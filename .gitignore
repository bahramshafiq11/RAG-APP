# Virtual environment (large, and everyone creates their own)
venv/
.venv/

# Python cache
__pycache__/
*.pyc

# Streamlit local settings
.streamlit/secrets.toml

# Editor and OS files
.vscode/
.DS_Store
Thumbs.db

# Your personal PDFs
*.pdf

# Keep the sample PDF (the ! means "except this")
!sample_docs/*.pdf

# Saved document data (contains the text of your PDFs)
saved_index/

# Your personal slider settings
settings.json